      "lid": 125,
      "label": "Dynamic charge voltage offset",
      "type": 13,
      "help": "With this function, the charging voltage can be dynamically adjusted according to the charging current.\\nThe offset is linearly dependent on the charging current. The smallest charging current of the battery pack is used as the current for the calculation.",
      "items": [
        {
          "name": 177,
          "lid": 144,
          "label": "On/Off",
          "type": 10,
          "default": "0",
          "dt": 9
        },
        {
          "name": 146,
          "lid": 126,
          "label": "Current",
          "unit": "A",
          "type": 17,
          "default": "0",
          "min": 0,
          "max": 500,
          "dt": 3,
          "help": "0=deactivated\\nThe current at which the maximum offset is added."
        },
        {
          "name": 148,
          "lid": 127,
          "label": "Min. Offset",
          "unit": "mV",
          "type": 3,
          "default": "0",
          "min": 0,
          "max": 5000,
          "dt": 3
