    {
      "name": 76,
      "lid": 148,
      "label": "Maximum cell voltage",
      "help": "As soon as the highest cell voltage exceeds this value, charging is only carried out with the minimum charging current.\\nNote: The value must be greater than the cell starting voltage.\\nAttention: When autobalancing is active, this voltage is replaced by the balance cell voltage!",
      "unit": "mV",
      "type": 3,
      "default": "3300",
      "min": 2500,
      "max": 5000,
      "dt": 3
    },
