    {
      "id": "serial-setup",
      "lid": 628,
      "title": "Serial interfaces",
      "description": "Configures the devices connected to Serial 0-2.",
      "summary_review": true,
      "actions": [
        {
          "type": "fill_datadevice_from_serial",
          "target_page": "p_datadevice",
          "target_iface_base": 163,
          "target_addr_base": 164,
          "target_name_base": 165,
          "max_devices": 32,
          "mappings": [
            {
              "serial_field": "s0_bms",
              "count_field": "s0_count",
              "datadevice_source": 7
            },
            {
              "serial_field": "s1_bms",
              "count_field": "s1_count",
              "datadevice_source": 8
            },
            {
              "serial_field": "s2_bms",
              "count_field": "s2_count",
              "datadevice_source": 9
            }
          ]
        }
      ],
      "steps": [
        {
          "id": "serial-step-0",
          "title": "Serial 0",
          "fields": [
            {
              "key": "s0_bms",
              "lid": 629,
              "page": "p_serial",
              "name": 1,
              "group": 0,
              "label": "What kind of device is connected?",
              "type": "select"
            },
            {
              "key": "s0_count",
              "lid": 630,
              "label": "How many devices are connected to this port?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s0_bms"
            }
          ]
        },
        {
          "id": "serial-step-1",
          "lid": 631,
          "title": "Serial 1",
          "description": "BMS on Serial 1 and number in the chain.",
          "fields": [
            {
              "key": "s1_bms",
              "lid": 629,
              "page": "p_serial",
              "name": 1,
              "group": 1,
              "label": "What kind of device is connected?",
              "type": "select"
            },
            {
              "key": "s1_count",
              "lid": 630,
              "label": "How many devices are connected to this port?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s1_bms"
            }
          ]
        },
        {
          "id": "serial-step-2",
          "lid": 632,
          "title": "Serial 2",
          "description": "BMS on Serial 2 and number in the chain.",
          "fields": [
            {
              "key": "s2_bms",
              "lid": 629,
              "page": "p_serial",
              "name": 1,
              "group": 2,
              "label": "What kind of device is connected?",
              "type": "select"
            },
            {
              "key": "s2_count",
              "lid": 630,
              "label": "How many devices are connected to this port?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s2_bms"
            }
          ]
        }
      ]
    },
    {
      "id": "inverter-setup",
      "lid": 633,
      "title": "Inverter",
      "description": "Configuration of the inverter and the basic charge control.",
      "steps": [
        {
          "id": "inverter-step-1",
          "lid": 634,
          "title": "Enable CAN and select the protocol",
          "fields": [
            {
              "key": "bms_can_enable",
              "page": "p_inverter",
              "name": 60,
              "group": 0,
              "label": "BMS Canbus enable",
              "hidden": true
            },
            {
              "key": "can_protocol",
              "lid": 635,
              "page": "p_inverter",
              "name": 2,
              "group": 0,
              "label": "CANBUS protocol"
            },
            {
              "key": "can_datasource",
              "lid": 636,
              "page": "p_inverter",
              "name": 83,
              "group": 0,
              "label": "Data source (active Data devices)",
              "editable": false,
              "hidden": false
            }
          ],
          "calculations": [
            {
              "id": "calc_can_enable",
              "expr": 1,
              "write_to": [
                "bms_can_enable"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_can_datasource_active",
              "expr": {
                "op": "active_data_devices_mask"
              },
              "write_to": [
                "can_datasource"
              ],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-2",
          "lid": 637,
          "title": "Basic data",
          "fields": [
            {
              "key": "cells",
              "lid": 213,
              "page": "p_serial",
              "name": 141,
              "group": 0,
              "label": "Number of cells"
            },
            {
              "key": "max_cell_mv",
              "lid": 638,
              "page": "p_invertercharge",
              "name": 76,
              "group": 0,
              "label": "Maximum cell voltage [mV]"
            },
            {
              "key": "absorb_v",
              "lid": 639,
              "page": "p_inverter",
              "name": 62,
              "group": 0,
              "label": "Absorption charging voltage [V]",
              "editable": false,
              "hidden": false
            },
            {
              "key": "float_v",
              "lid": 640,
              "page": "p_inverter",
              "name": 156,
              "group": 0,
              "label": "Float charging voltage [V]",
              "editable": false,
              "hidden": false
            },
            {
              "key": "float_soc",
              "lid": 641,
              "page": "p_inverter",
              "name": 85,
              "group": 0,
              "label": "Float charging voltage SoC [%]",
              "editable": false,
              "hidden": true
            }
          ],
          "calculations": [
            {
              "id": "calc_absorb",
              "expr": {
                "op": "div",
                "args": [
                  {
                    "op": "mul",
                    "args": [
                      {
                        "field": "max_cell_mv"
                      },
                      {
                        "field": "cells"
                      }
                    ]
                  },
                  1000
                ]
              },
              "round": {
                "mode": "up",
                "step": 0.1
              },
              "write_to": [
                "absorb_v"
              ]
            },
            {
              "id": "calc_float_v",
              "expr": {
                "op": "mul",
                "args": [
                  3.37,
                  {
                    "field": "cells"
                  }
                ]
              },
              "round": {
                "mode": "nearest",
                "decimals": 1
              },
              "write_to": [
                "float_v"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_float_soc",
              "expr": 90,
              "write_to": [
                "float_soc"
              ],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-3",
          "lid": 642,
          "title": "Cell voltage dependent throttling",
          "fields": [
            {
              "key": "zspg_en",
              "lid": 643,
              "page": "p_invertercharge",
              "name": 74,
              "group": 0,
              "label": "Cell voltage dependent throttling on/off",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_start",
              "lid": 644,
              "page": "p_invertercharge",
              "name": 75,
              "group": 0,
              "label": "Start at cell voltage above [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_float",
              "lid": 645,
              "page": "p_invertercharge",
              "name": 205,
              "group": 0,
              "label": "Maximum cell voltage (float) [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_min_current",
              "lid": 149,
              "page": "p_invertercharge",
              "name": 78,
              "group": 0,
              "label": "Minimum charging current",
              "editable": false,
              "hidden": true,
              "unit": "A"
            }
          ],
          "calculations": [
            {
              "id": "calc_zspg_en",
              "expr": 1,
              "write_to": [
                "zspg_en"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_start",
              "expr": 3370,
              "write_to": [
                "zspg_start"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_float",
              "expr": 3370,
              "write_to": [
                "zspg_float"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_min_current",
              "expr": 0,
              "write_to": [
                "zspg_min_current"
              ],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-4",
          "lid": 646,
          "title": "Cell drift throttling",
          "fields": [
            {
              "key": "drift_en",
              "lid": 647,
              "page": "p_invertercharge",
              "name": 68,
              "group": 0,
              "label": "Cell drift throttling on/off",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_start_spg",
              "lid": 644,
              "page": "p_invertercharge",
              "name": 71,
              "group": 0,
              "label": "Start at cell voltage above [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_start_diff",
              "lid": 648,
              "page": "p_invertercharge",
              "name": 69,
              "group": 0,
              "label": "Start at drift above [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_red_per_mv",
              "lid": 649,
              "page": "p_invertercharge",
              "name": 70,
              "group": 0,
              "label": "Reduction per mV [A]",
              "editable": false,
              "hidden": true
            }
          ],
          "calculations": [
            {
              "id": "calc_drift_en",
              "expr": 1,
              "write_to": [
                "drift_en"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_start_spg",
              "expr": 3400,
              "write_to": [
                "drift_start_spg"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_start_diff",
              "expr": 20,
              "write_to": [
                "drift_start_diff"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_red_per_mv",
              "expr": 2,
              "write_to": [
                "drift_red_per_mv"
              ],
              "force_on_load": true
            }
          ]
        }
      ],
      "summary_review": true
    }
  ]
}
