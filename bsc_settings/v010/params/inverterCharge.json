          "lid": 126,
          "label": "Strom",
          "unit": "A",
          "type": "HTML_INPUTFLOAT_2",
          "default": "0",
          "min": 0,
          "max": 500,
          "dt": "PARAM_DT_U16",
          "help": "Der Strom, bei dem der maximale Offset addiert wird."
        },
        {
          "name": "ID_PARAM_DYNAMIC_CHARGE_VOLTAGE_OFFSET_MIN",
          "lid": 127,
          "label": "Min. Offset",
          "unit": "mV",
          "type": "HTML_INPUTNUMBER",
          "default": "0",
          "min": 0,
          "max": 5000,
          "dt": "PARAM_DT_U16"
        },
        {
          "name": "ID_PARAM_DYNAMIC_CHARGE_VOLTAGE_OFFSET_MAX",
          "lid": 128,
          "label": "Max. Offset",
          "unit": "mV",
          "type": "HTML_INPUTNUMBER",
          "default": "500",
          "min": 0,
          "max": 5000,
          "dt": "PARAM_DT_U16"
        }
      ],
      "section_id": "UI_SECT_INVERTERCHARGE_DYNAMISCHER_LADESPANNUNGSOFFSET"
    },
