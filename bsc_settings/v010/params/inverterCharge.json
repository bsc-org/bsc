        {
          "name": "ID_PARAM_DYNAMIC_CHARGE_VOLTAGE_ON",
          "lid": 144,
          "label": "Ein/Aus",
          "type": "HTML_INPUTCHECKBOX",
          "default": "0",
          "dt": "PARAM_DT_BO"
        },
        {
