    {
      "lid": 298,
      "label": "Ladespannungsrampe",
      "type": "HTML_SEPARATION",
      "help": "Mit der Funktion wird die Ladespannung auf den neuen Sollwert geregelt.\nModus Zeitrampe: Änderung pro Schritt zeitbasiert. Pro Schritt wird die Ladespannung um 100 mV geändert.\nModus Auto: Erhöhung per Zeitrampe, Absenkung spannungsgeführt über die aktuelle Batteriespannung; dabei wird der Ladestrom kurzzeitig auf 0 A gesetzt, bis die Zielspannung erreicht ist.",
      "wiki": "settings_inverter/#a_ladespannungsrampe",
      "items": [
        {
          "name": "ID_PARAM_CHARGE_VOLTAGE_RAMP_ON",
          "lid": 386,
          "label": "Modus",
          "type": "HTML_INPUTSELECT",
          "options": [
            {
              "v": "OPTION_CHARGE_VOLTAGE_RAMP_OFF",
              "lid": 257,
              "l": "Aus"
            },
            {
              "v": "OPTION_CHARGE_VOLTAGE_RAMP_TIME",
              "lid": 387,
              "l": "Zeitrampe"
            },
            {
              "v": "OPTION_CHARGE_VOLTAGE_RAMP_AUTO",
              "lid": 388,
              "l": "Auto"
            }
          ],
          "default": "OPTION_CHARGE_VOLTAGE_RAMP_OFF",
          "dt": "PARAM_DT_U8"
        },
        {
          "name": "ID_PARAM_CHARGE_VOLTAGE_STEP_TIME",
          "lid": 299,
          "label": "Zeit pro Spannungsschritt",
          "unit": "s",
          "type": "HTML_INPUTNUMBER",
          "default": 15,
          "min": 1,
          "max": 240,
          "dt": "PARAM_DT_U8"
        }
      ],
      "section_id": "UI_SECT_BMSTOINVERTER_LADESPANNUNGSRAMPE"
    },
