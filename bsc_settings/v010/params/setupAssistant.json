    {
      "id": "serial-setup",
      "title": "Serielle Schnittstellen",
      "description": "Konfiguriert die an Serial 0-2 angeschlossenen Geräte.",
      "summary_review": true,
      "actions": [
        {
          "type": "fill_datadevice_from_serial",
          "target_page": "p_datadevice",
          "target_iface_base": "ID_PARAM_DEVICE_MAPPING_SCHNITTSTELLE",
          "target_addr_base": "ID_PARAM_DEVICE_MAPPING_ADRESSE",
          "target_name_base": "ID_PARAM_DEVICE_MAPPING_NAME",
          "max_devices": 32,
          "mappings": [
          {
            "serial_field": "s0_bms",
            "count_field": "s0_count",
            "datadevice_source": 7
          },
          {
            "serial_field": "s1_bms",
            "count_field": "s1_count",
            "datadevice_source": 8
          },
          {
            "serial_field": "s2_bms",
            "count_field": "s2_count",
            "datadevice_source": 9
          }
          ]
        }
      ],
      "steps": [
        {
          "id": "serial-step-0",
          "title": "Serial 0",
          "fields": [
            {
              "key": "s0_bms",
              "page": "p_serial",
              "name": "ID_PARAM_SERIAL_CONNECT_DEVICE",
              "group": 0,
              "label": "Was für ein Gerät ist angeschlossen?",
              "type": "select"
            },
            {
              "key": "s0_count",
              "label": "Wie viele Geräte sind an dem Port angeschlossen?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s0_bms"
            }
          ]
        },
        {
          "id": "serial-step-1",
          "title": "Serial 1",
          "description": "BMS an Serial 1 und Anzahl in Kette.",
          "fields": [
            {
              "key": "s1_bms",
              "page": "p_serial",
              "name": "ID_PARAM_SERIAL_CONNECT_DEVICE",
              "group": 1,
              "label": "Was für ein Gerät ist angeschlossen?",
              "type": "select"
            },
            {
              "key": "s1_count",
              "label": "Wie viele Geräte sind an dem Port angeschlossen?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s1_bms"
            }
          ]
        },
        {
          "id": "serial-step-2",
          "title": "Serial 2",
          "description": "BMS an Serial 2 und Anzahl in Kette.",
          "fields": [
            {
              "key": "s2_bms",
              "page": "p_serial",
              "name": "ID_PARAM_SERIAL_CONNECT_DEVICE",
              "group": 2,
              "label": "Was für ein Gerät ist angeschlossen?",
              "type": "select"
            },
            {
              "key": "s2_count",
              "label": "Wie viele Geräte sind an dem Port angeschlossen?",
              "type": "number",
              "min": 1,
              "max": 16,
              "default": 1,
              "required": false,
              "local_only": true,
              "show_when_chainable_of": "s2_bms"
            }
          ]
        }
      ]
    },

    {
      "id": "inverter-setup",
      "title": "Wechselrichter",
      "description": "Konfiguration des Wechselrichters und der Basis Laderegelung.",
      "steps": [
        {
          "id": "inverter-step-1",
          "title": "CAN aktivieren und Protokoll auswählen",
          "fields": [
            {
              "key": "bms_can_enable",
              "page": "p_inverter",
              "name": "ID_PARAM_BMS_CAN_ENABLE",
              "group": 0,
              "label": "BMS Canbus enable",
              "hidden": true
            },
            {
              "key": "can_protocol",
              "page": "p_inverter",
              "name": "ID_PARAM_SS_CAN",
              "group": 0,
              "label": "CANBUS Protokoll"
            },
            {
              "key": "can_datasource",
              "page": "p_inverter",
              "name": "ID_PARAM_BMS_CAN_DATASOURCE_SS1",
              "group": 0,
              "label": "Datenquelle (aktive Data-Devices)",
              "editable": false,
              "hidden": false
            }
          ],
          "calculations": [
            {
              "id": "calc_can_enable",
              "expr": 1,
              "write_to": ["bms_can_enable"],
              "force_on_load": true
            },
            {
              "id": "calc_can_datasource_active",
              "expr": {"op": "active_data_devices_mask"},
              "write_to": ["can_datasource"],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-2",
          "title": "Basisdaten",
          "fields": [
            {
              "key": "cells",
              "page": "p_serial",
              "name": "ID_PARAM_SERIAL_NUMBER_OF_CELLS",
              "group": 0,
              "label": "Anzahl Zellen"
            },
            {
              "key": "max_cell_mv",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLSPG_ENDSPG",
              "group": 0,
              "label": "Maximale Zellspannung [mV]"
            },
            {
              "key": "absorb_v",
              "page": "p_inverter",
              "name": "ID_PARAM_BMS_MAX_CHARGE_SPG",
              "group": 0,
              "label": "Absorption Ladespannung [V]",
              "editable": false,
              "hidden": false
            },
            {
              "key": "float_v",
              "page": "p_inverter",
              "name": "ID_PARAM_BMS_FLOAT_CHARGE_SPG",
              "group": 0,
              "label": "Float Ladespannung [V]",
              "editable": false,
              "hidden": false
            },
            {
              "key": "float_soc",
              "page": "p_inverter",
              "name": "ID_PARAM_INVERTER_CHARGE_CURRENT_CUT_OFF_SOC",
              "group": 0,
              "label": "Float Ladespannung SoC [%]",
              "editable": false,
              "hidden": true
            }
          ],
          "calculations": [
            {
              "id": "calc_absorb",
              "expr": {
                "op": "div",
                "args": [
                  {
                    "op": "mul",
                    "args": [
                      {"field": "max_cell_mv"},
                      {"field": "cells"}
                    ]
                  },
                  1000
                ]
              },
              "round": {"mode": "up","step": 0.1},
              "write_to": ["absorb_v"]
            },
            {
              "id": "calc_float_v",
              "expr": {
                "op": "mul",
                "args": [
                  3.37,
                  {"field": "cells"}
                ]
              },
              "round": {"mode": "nearest","decimals": 1},
              "write_to": ["float_v"],
              "force_on_load": true
            },
            {
              "id": "calc_float_soc",
              "expr": 90,
              "write_to": ["float_soc"],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-3",
          "title": "Zellspannungsabhaengige Drosselung",
          "fields": [
            {
              "key": "zspg_en",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLSPG_EN",
              "group": 0,
              "label": "Zellspannungsabhaengige Drosselung Ein/Aus",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_start",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLSPG_STARTSPG",
              "group": 0,
              "label": "Starten bei Zellspg. groesser [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_float",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLSPG_ENDSPG_FLOAT",
              "group": 0,
              "label": "Maximale Zellspannung (Float) [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "zspg_min_current",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLSPG_MINDEST_STROM",
              "group": 0,
              "label": "Mindest Ladestrom",
              "editable": false,
              "hidden": true
            }
          ],
          "calculations": [
            {
              "id": "calc_zspg_en",
              "expr": 1,
              "write_to": [
                "zspg_en"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_start",
              "expr": 3370,
              "write_to": [
                "zspg_start"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_float",
              "expr": 3370,
              "write_to": [
                "zspg_float"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_zspg_min_current",
              "expr": 0,
              "write_to": [
                "zspg_min_current"
              ],
              "force_on_load": true
            }
          ]
        },
        {
          "id": "inverter-step-4",
          "title": "Zelldrift-Drosselung",
          "fields": [
            {
              "key": "drift_en",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_ZELLDRIFT_EN",
              "group": 0,
              "label": "Zelldrift-Drosselung Ein/Aus",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_start_spg",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_STARTSPG_ZELLE",
              "group": 0,
              "label": "Starten bei Zellspg. groesser [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_start_diff",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_STARTABWEICHUNG",
              "group": 0,
              "label": "Starten bei Drift groesser [mV]",
              "editable": false,
              "hidden": true
            },
            {
              "key": "drift_red_per_mv",
              "page": "p_invertercharge",
              "name": "ID_PARAM_INVERTER_LADESTROM_REDUZIEREN_A_PRO_MV",
              "group": 0,
              "label": "Reduzierung pro mV [A]",
              "editable": false,
              "hidden": true
            }
          ],
          "calculations": [
            {
              "id": "calc_drift_en",
              "expr": 1,
              "write_to": [
                "drift_en"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_start_spg",
              "expr": 3400,
              "write_to": [
                "drift_start_spg"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_start_diff",
              "expr": 20,
              "write_to": [
                "drift_start_diff"
              ],
              "force_on_load": true
            },
            {
              "id": "calc_drift_red_per_mv",
              "expr": 2,
              "write_to": [
                "drift_red_per_mv"
              ],
              "force_on_load": true
            }
          ]
        }
      ],
      "summary_review": true
    }

  ]
}
